# ========================================================
# Ocean Drive Car Rental - Environment Configuration
# Copy this file to .env and configure for your local environment
# ========================================================

# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ocean_drive_db
DB_USER=ocean_user
DB_PASSWORD=your_secure_password_here

# Mailer & Admin Configuration
ADMIN_EMAIL=reservas@oceandrivecarental.com
FROM_EMAIL=reservas@oceandrivecarental.com
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=reservas@oceandrivecarental.com
SMTP_PASSWORD=your_smtp_password_here

# Application Configuration
APP_ENV=development
APP_DEBUG=true
